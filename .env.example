# ───────── Rento · Miljøvariabler (eksempel) ─────────
# Kopier denne filen til .env.local for lokal utvikling,
# og sett tilsvarende variabler i Vercel (Project → Settings → Environment Variables).

# Neon Postgres (https://console.neon.tech)
# Pooled URL (for serverless / Vercel). Legg til ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-west-1.aws.neon.tech/rento?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct connection (for prisma migrate). Uten pgbouncer-flagget.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-west-1.aws.neon.tech/rento?sslmode=require"

# App URL (brukes av Stripe redirects og NextAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ───────── Auth (NextAuth v5) ─────────
# Generer: `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# E-post-innlogging (magic link). Eksempel: Resend SMTP relay eller Postmark.
EMAIL_SERVER="smtp://user:pass@smtp.resend.com:587"
EMAIL_FROM="Rento <hei@rentobil.no>"

# Google OAuth (valgfritt)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────── Stripe ─────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
