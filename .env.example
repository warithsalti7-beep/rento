# ───────── Rento · Miljøvariabler (eksempel) ─────────
# Kopier denne filen til .env for lokal utvikling,
# og sett tilsvarende variabler i Vercel (Project → Settings → Environment Variables).

# Neon Postgres (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/rento?sslmode=require&pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/rento?sslmode=require"

# App URL (brukes av Vipps/Stripe redirects og NextAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Norwegian org number (shown in footer once registered)
NEXT_PUBLIC_ORG_NUMBER=""

# ───────── Auth (NextAuth v5) ─────────
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# E-post-innlogging (magic link)
EMAIL_SERVER="smtp://user:pass@smtp.resend.com:587"
EMAIL_FROM="Rento <hei@rentobil.no>"

# Google OAuth (valgfritt)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────── Stripe (fallback for kortbetaling) ─────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ───────── Vipps (hovedbetaling i Norge) ─────────
# https://portal.vipps.no -> get these once merchant agreement is signed.
VIPPS_BASE_URL="https://apitest.vipps.no"
VIPPS_CLIENT_ID=""
VIPPS_CLIENT_SECRET=""
VIPPS_SUBSCRIPTION_KEY=""
VIPPS_MERCHANT_SERIAL_NUMBER=""

# ───────── Vercel Blob (document upload) ─────────
# Auto-injected by Vercel when you create a Blob store on the project.
BLOB_READ_WRITE_TOKEN=""
